<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MineSweeper.MainWindow"
        Title="MineSweeper">
        
        
    <StackPanel>
        <Border Margin="5" CornerRadius="10" Background="DarkGray">
            <TextBlock Margin="5"
                       HorizontalAlignment="Center"
                       FontSize="24"
                       Text="MineSweeper">
            </TextBlock>
        </Border>
        <Label
            Content="Tid: "
            Name="ShowTime"
            HorizontalAlignment="Center">
        </Label>

        <!-- Grid størrelse -->
        <Grid ShowGridLines="False" Margin="5"
              ColumnDefinitions="100, 100, 100, 100, 100, 100"
              RowDefinitions="100, 100, 100, 100, 100, 100"
              HorizontalAlignment="Center">

            <!-- Kanpper i grid -->
            <Button Grid.Row="0" Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedEmpty"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="0" Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="0" Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedBoom"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="0" Grid.Column="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedTwo"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="0" Grid.Column="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedBoom"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="0" Grid.Column="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>

            <Button Grid.Row="1" Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="1" Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedTwo"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="1" Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedTwo"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="1" Grid.Column="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="1" Grid.Column="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="1" Grid.Column="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>

            <Button Grid.Row="2" Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="2" Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedBoom"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="2" Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedTwo"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="2" Grid.Column="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="2" Grid.Column="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedEmpty"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="2" Grid.Column="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedEmpty"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>

            <Button Grid.Row="3" Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="3" Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedTwo"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="3" Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedBoom"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="3" Grid.Column="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedTwo"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="3" Grid.Column="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="3" Grid.Column="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>

            <Button Grid.Row="4" Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedEmpty"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="4" Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="4" Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="4" Grid.Column="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedTwo"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="4" Grid.Column="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedBoom"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="4" Grid.Column="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>

            <Button Grid.Row="5" Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedEmpty"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="5" Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedEmpty"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="5" Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedEmpty"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="5" Grid.Column="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="5" Grid.Column="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            <Button Grid.Row="5" Grid.Column="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="98" Width="98"
                    Click="PressedOne"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
            </Button>
            
            <!--
                    
                    
                    -->
        </Grid>
        <!--
        <Button HorizontalAlignment="Center"
        Click="PressedReset"
        Content="Reset Game">
        </Button>
        -->
    </StackPanel>
</Window>